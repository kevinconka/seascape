{
  "$defs": {
    "Band": {
      "enum": [
        "eo",
        "ir"
      ],
      "type": "string"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/Band"
        },
        "fan_deg": {
          "default": 0.0,
          "title": "Fan Deg",
          "type": "number"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "hfov_deg": {
          "exclusiveMaximum": 180.0,
          "exclusiveMinimum": 0.0,
          "title": "Hfov Deg",
          "type": "number"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "hfov_deg",
        "width_px",
        "height_px"
      ],
      "title": "Camera",
      "type": "object"
    },
    "ImageFormat": {
      "enum": [
        "exr",
        "png"
      ],
      "type": "string"
    },
    "Object": {
      "additionalProperties": false,
      "description": "Something to detect.",
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "range_m": {
          "exclusiveMinimum": 0.0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_deg": {
          "title": "Bearing Deg",
          "type": "number"
        },
        "heading_deg": {
          "default": 0.0,
          "title": "Heading Deg",
          "type": "number"
        },
        "t_k": {
          "default": 293.0,
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "range_m",
        "bearing_deg"
      ],
      "title": "Object",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "What a render writes.\n\nEvery camera of a listed band is rendered; a scene is built per band, in Cycles.\n\nEXR by default: it is float, so an LWIR pixel stays the radiance in W m^-2 sr^-1\nthat the render produced. PNG is 8-bit and needs a mapping onto it -- for EO the\nexposure below and Blender's AgX film curve, for LWIR an auto-contrast over the\nframe, which is a picture rather than a measurement.",
      "properties": {
        "bands": {
          "default": [
            "eo",
            "ir"
          ],
          "items": {
            "$ref": "#/$defs/Band"
          },
          "minItems": 1,
          "title": "Bands",
          "type": "array",
          "uniqueItems": true
        },
        "samples": {
          "$ref": "#/$defs/Samples"
        },
        "format": {
          "$ref": "#/$defs/ImageFormat",
          "default": "exr"
        },
        "exposure_ev": {
          "default": -5.0,
          "maximum": 32.0,
          "minimum": -32.0,
          "title": "Exposure Ev",
          "type": "number"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Ownship": {
      "additionalProperties": false,
      "description": "The vessel the rig is bolted to. Its cameras see its own deck.",
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "t_k": {
          "default": 296.0,
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        }
      },
      "required": [
        "asset"
      ],
      "title": "Ownship",
      "type": "object"
    },
    "Pod": {
      "additionalProperties": false,
      "description": "One enclosure: several cameras behind one yaw and one mount point.\n\nOffsets matter: pods a beam apart overlap in angle before they overlap in space,\nwhich is the blind wedge over the bow. Coincident cameras would hide it.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Name",
          "type": "string"
        },
        "yaw_deg": {
          "title": "Yaw Deg",
          "type": "number"
        },
        "offset_x_m": {
          "default": 0.0,
          "title": "Offset X M",
          "type": "number"
        },
        "offset_y_m": {
          "default": 0.0,
          "title": "Offset Y M",
          "type": "number"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/Camera"
          },
          "minItems": 1,
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "name",
        "yaw_deg",
        "cameras"
      ],
      "title": "Pod",
      "type": "object"
    },
    "Rig": {
      "additionalProperties": false,
      "description": "The pods on the ownship.",
      "properties": {
        "height_m": {
          "exclusiveMinimum": 0.0,
          "title": "Height M",
          "type": "number"
        },
        "tilt_deg": {
          "default": 0.0,
          "title": "Tilt Deg",
          "type": "number"
        },
        "pods": {
          "items": {
            "$ref": "#/$defs/Pod"
          },
          "minItems": 1,
          "title": "Pods",
          "type": "array"
        }
      },
      "required": [
        "height_m",
        "pods"
      ],
      "title": "Rig",
      "type": "object"
    },
    "Samples": {
      "additionalProperties": false,
      "description": "Cycles samples per band.\n\nA model so an override merges field by field; a dict would replace it whole\nand drop the band left out.",
      "properties": {
        "eo": {
          "default": 16,
          "exclusiveMinimum": 0,
          "title": "Eo",
          "type": "integer"
        },
        "ir": {
          "default": 64,
          "exclusiveMinimum": 0,
          "title": "Ir",
          "type": "integer"
        }
      },
      "title": "Samples",
      "type": "object"
    },
    "Sea": {
      "additionalProperties": false,
      "description": "Sea state. Wind reaches the waves through wavelength and slope; see `scene`.\n\n271-311 K is the span of the shipped optical-constant table. `lwir` clamps to it;\nhere it is an error.",
      "properties": {
        "t_sea_k": {
          "default": 288.0,
          "maximum": 311.0,
          "minimum": 271.0,
          "title": "T Sea K",
          "type": "number"
        },
        "wind_speed_mps": {
          "default": 7.0,
          "minimum": 0.0,
          "title": "Wind Speed Mps",
          "type": "number"
        },
        "refraction_k": {
          "default": 0.13,
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Refraction K",
          "type": "number"
        }
      },
      "title": "Sea",
      "type": "object"
    },
    "Sky": {
      "additionalProperties": false,
      "description": "Blender's Sky Texture in EO, and the downwelling radiance the sea reflects in IR.\n\nHaze is `aerosol_density`, the node's own parameter. Its `turbidity` belongs to the\nPreetham and Hosek-Wilkie models and is ignored by this one, so naming it that would\nbe a knob that changes nothing.\n\n`t_air_k` scales the IR sky and nothing in EO. Its bound is where the fixed sky\nprofile stays credible; a colder or hotter sea needs a new profile, not a wider\nbound.",
      "properties": {
        "sun_elevation_deg": {
          "default": 30.0,
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Sun Elevation Deg",
          "type": "number"
        },
        "sun_bearing_deg": {
          "default": 0.0,
          "title": "Sun Bearing Deg",
          "type": "number"
        },
        "aerosol_density": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Aerosol Density",
          "type": "number"
        },
        "t_air_k": {
          "default": 288.0,
          "maximum": 320.0,
          "minimum": 250.0,
          "title": "T Air K",
          "type": "number"
        }
      },
      "title": "Sky",
      "type": "object"
    },
    "Targets": {
      "additionalProperties": false,
      "description": "A ring of vessels at one range, spread over a span of bearings.\n\nWorld objects: nothing here refers to the rig, so per-camera coverage is a test,\nnot a guarantee.",
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "range_m": {
          "exclusiveMinimum": 0.0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_deg": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bearing Deg",
          "type": "array"
        },
        "heading_deg": {
          "default": [
            0.0,
            315.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Heading Deg",
          "type": "array"
        },
        "t_k": {
          "default": 293.0,
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "count",
        "range_m",
        "bearing_deg"
      ],
      "title": "Targets",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "rig": {
      "$ref": "#/$defs/Rig"
    },
    "ownship": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ownship"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "targets": {
      "anyOf": [
        {
          "$ref": "#/$defs/Targets"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sea": {
      "$ref": "#/$defs/Sea"
    },
    "sky": {
      "$ref": "#/$defs/Sky"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/Object"
      },
      "title": "Objects",
      "type": "array"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    }
  },
  "required": [
    "rig"
  ],
  "title": "Scenario",
  "type": "object"
}
